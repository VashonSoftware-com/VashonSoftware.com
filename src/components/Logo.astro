---
/**
 * Logo Component
 *
 * AstroDeck brand logo with card deck icon and wordmark.
 * Used consistently across Header, Footer, and Auth layouts.
 *
 * @example
 * ```astro
 * <Logo />
 * <Logo showText={false} />
 * <Logo size="lg" />
 * ```
 */
interface Props {
  /** Show the "AstroDeck" text next to the icon */
  showText?: boolean;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Additional CSS classes */
  class?: string;
}

const { showText = true, size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'h-5 w-5',
  md: 'h-6 w-6',
  lg: 'h-8 w-8',
  xl: 'h-10 w-10',
};

const imageSizes = {
  sm: 20,
  md: 24,
  lg: 32,
  xl: 40,
};

const textSizeClasses = {
  sm: 'text-sm',
  md: 'text-base',
  lg: 'text-lg',
  xl: 'text-xl',
};
---

<a href="/" class:list={['flex items-center space-x-2', className]}>
  <img
    src="/icons/logo-navbar-128.png"
    alt="Vashon Software logo"
    width={imageSizes[size]}
    height={imageSizes[size]}
    class={sizeClasses[size]}
    loading="eager"
    decoding="async"
  />
  {showText && <span class:list={['font-bold', textSizeClasses[size]]}>Vashon Software</span>}
</a>

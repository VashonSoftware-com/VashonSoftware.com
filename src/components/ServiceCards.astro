---
/** Grid of service cards: title, description, optional link (internal or external). */
export interface ServiceCard {
  title: string;
  description: string;
  href?: string;
}

interface Props {
  cards: ServiceCard[];
  class?: string;
}

const { cards, class: className = '' } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<div class:list={['grid gap-6 sm:grid-cols-2 lg:grid-cols-3', className]}>
  {
    cards.map((card) => (
      <div class="rounded-lg border bg-card p-6 hover:shadow-md transition-shadow">
        <h3 class="text-lg mb-2">
          {card.href ? (
            <a
              href={card.href}
              class="underline underline-offset-4 hover:text-primary"
              {...(isExternal(card.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {card.title} →
            </a>
          ) : (
            card.title
          )}
        </h3>
        <p class="text-sm text-muted-foreground leading-relaxed">{card.description}</p>
      </div>
    ))
  }
</div>

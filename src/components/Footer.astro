---
/**
 * Footer Component
 *
 * Unified footer with boxed and fullWidth variants.
 * Contains navigation links, resources, and creator info.
 *
 * @example
 * ```astro
 * <Footer />
 * <Footer variant="fullWidth" />
 * ```
 */
import Logo from './Logo.astro';
import ObfuscatedEmail from './ObfuscatedEmail.astro';

interface Props {
  /** Layout variant - boxed (default) or fullWidth */
  variant?: 'boxed' | 'fullWidth';
}

const { variant = 'boxed' } = Astro.props;

const footerLinks = {
  pages: [
    { href: '/', label: 'Home' },
    { href: '/services', label: 'Services' },
    { href: '/blog', label: 'Blog' },
    { href: '/contact', label: 'Contact' },
    { href: '/privacy', label: 'Privacy' },
  ],
  services: [
    { href: '/services#crafted-software', label: 'Custom Applications' },
    { href: '/services#crafted-software', label: 'Mobile Apps' },
    { href: '/services#crafted-software', label: 'Cloud Solutions' },
    { href: '/services#websites', label: 'Web Development' },
    { href: '/services#websites', label: 'E-commerce & CMS' },
    { href: '/services#disaster-technology', label: 'Disaster Technology' },
  ],
};

const containerClass =
  variant === 'fullWidth' ? 'w-full px-4' : 'container max-w-5xl mx-auto px-4 sm:px-6';
---

<footer class="border-t bg-background">
  <div class:list={[containerClass, 'py-12']}>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <Logo />
        <p class="mt-4 text-sm text-muted-foreground">
          Custom software development and technology solutions for businesses that need technology
          that works.
        </p>
        <div class="mt-4 inline-flex items-center gap-2 text-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 text-primary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <ObfuscatedEmail user="info" domain="VashonSoftware.com" class="text-primary hover:underline" />
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-semibold mb-4">Navigation</h3>
        <ul class="space-y-2">
          {
            footerLinks.pages.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted-foreground hover:text-foreground transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-semibold mb-4">Services</h3>
        <ul class="space-y-2">
          {
            footerLinks.services.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted-foreground hover:text-foreground transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-semibold mb-4">Contact</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li>Vashon Island, Washington</li>
          <li>
            <ObfuscatedEmail user="info" domain="VashonSoftware.com" class="hover:text-foreground transition-colors" />
          </li>
          <li>
            <a href="/contact" class="hover:text-foreground transition-colors">
              Send a message →
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 border-t pt-8 text-center text-sm text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} Vashon Software. All rights reserved.</p>
    </div>
  </div>
</footer>

---
/**
 * Section header: an h2 (or h3) with an optional subtitle.
 * Size comes from .section-title in globals.css.
 */
interface Props {
  title: string;
  subtitle?: string;
  as?: 'h2' | 'h3';
  /** Center the text (for full-width marketing sections). */
  center?: boolean;
  class?: string;
}

const { title, subtitle, as: Tag = 'h2', center = false, class: className = '' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<div class:list={[center ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl', className]}>
  <Tag class="section-title">{title}</Tag>
  {subtitle && <p class="mt-2 text-muted-foreground leading-relaxed">{subtitle}</p>}
  {
    hasSlot && (
      <div class="mt-3 text-muted-foreground leading-relaxed">
        <slot />
      </div>
    )
  }
</div>

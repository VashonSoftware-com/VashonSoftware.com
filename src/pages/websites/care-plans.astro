---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import TalkToJohn from '@/components/TalkToJohn.astro';
import WebsitesNav from '@/components/WebsitesNav.astro';
import { Image } from 'astro:assets';
import logoSrc from '@/assets/logo-navbar-128.png';
import { carePlans, careRows, healthCheck } from '@/data/websites';

const featured = carePlans.findIndex((p) => p.featured);
const cellTint = (i: number) => (i === featured ? 'bg-primary/5' : '');
---

<BaseLayout
  title="Website care plans"
  description="Optional care plans for Vashon Software websites: Care ($10/month or $100/year, automated monthly report and backups), Care + review ($30/month or $300/year, a quarterly check by a person) and Total care (by quote)."
>
  <PageHeader
    title="Care plans"
    crumbs={[{ label: 'Websites', href: '/websites' }, { label: 'Care plans' }]}
  >
    A site with nothing to patch needs little looking after, so a plan is optional. What a plan adds
    is regular check-ups, a report, and some change time. Pay monthly, or yearly and get two months
    free.
  </PageHeader>
  <WebsitesNav />

  <!-- Care plans -->
  <section id="care" class="py-16 border-t" aria-label="Care plans">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="overflow-x-auto rounded-lg border">
        <table class="w-full min-w-[40rem] text-sm">
          <caption class="sr-only">What each care plan includes</caption>
          <thead class="bg-muted/40">
            <tr>
              <th scope="col" class="p-3 text-left font-semibold align-bottom"
                ><span class="sr-only">Included</span></th
              >
              {
                carePlans.map((plan, i) => (
                  <th
                    scope="col"
                    class:list={[
                      'p-3 text-left align-bottom font-normal',
                      i === featured && 'bg-primary/10 border-t-4 border-primary',
                    ]}
                  >
                    {i > 0 && (
                      <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <Image src={logoSrc} alt="" width={16} height={16} class="h-4 w-4" />
                        Vashon Software
                      </span>
                    )}
                    <span
                      class:list={[
                        'block text-base font-semibold',
                        i === featured && 'text-primary',
                      ]}
                    >
                      {plan.name}
                    </span>
                    <span class="block text-xs text-muted-foreground">{plan.tagline}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              careRows.map((row) => (
                <tr class="border-t align-top">
                  <th scope="row" class="p-3 text-left font-medium">
                    {row.label}
                  </th>
                  {row.cells.map((cell, i) => (
                    <td
                      class:list={[
                        'p-3',
                        cell === '—' && 'text-muted-foreground',
                        cellTint(i),
                      ]}
                    >
                      {cell === '—' ? <span aria-label="not included">—</span> : cell}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-foreground/20 bg-muted/40 align-top">
              <th scope="row" class="p-3 text-left font-semibold">Cost</th>
              {
                carePlans.map((plan, i) => (
                  <td class:list={['p-3', i === featured && 'bg-primary/10']}>
                    <span class="block text-base font-semibold">{plan.price}</span>
                    {plan.perYear && (
                      <span class="block text-xs text-muted-foreground">{plan.perYear}</span>
                    )}
                  </td>
                ))
              }
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted-foreground max-w-3xl">
        I'm a one-person business. When I'm travelling or away, I say so ahead of time, and
        monitoring alerts still reach me; Total care sites come first when I'm back.
      </p>

      <div class="mt-8 rounded-lg border bg-card p-6">
        <h3 class="font-semibold text-lg mb-4">What a health check covers</h3>
        <ul class="grid gap-3 sm:grid-cols-2 text-sm text-muted-foreground leading-relaxed">
          {
            healthCheck.map(([name, desc]) => (
              <li>
                <span class="font-medium text-foreground">{name}.</span> {desc}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <TalkToJohn
    title="Questions about a plan?"
    text="Ask which plan suits your site, or whether you need one at all. I typically reply within one business day."
  />
</BaseLayout>

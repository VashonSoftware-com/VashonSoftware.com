---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import TalkToJohn from '@/components/TalkToJohn.astro';
import WebsitesNav from '@/components/WebsitesNav.astro';
import { compareCols, platforms } from '@/data/websites';
---

<BaseLayout
  title="Compared with other website platforms"
  description="A built-and-owned website compared with Wix, Squarespace, GoDaddy, WordPress.com, self-hosted WordPress, Webflow, Shopify, Square Online and Google Sites: running cost, editing, moving it later, and what happens if you stop paying."
>
  <PageHeader
    title="Compared with other platforms"
    crumbs={[{ label: 'Websites', href: '/websites' }, { label: 'Compared' }]}
  >
    These are good products, each best at something. The main difference is the arrangement: with a
    builder you rent the site month by month; here you pay once to have it built, then own it and
    run it nearly free.
    <WebsitesNav slot="after" />
  </PageHeader>

  <!-- Comparison -->
  <section id="compare" class="py-16 border-t" aria-label="Platform comparison">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="overflow-x-auto rounded-lg border">
        <table class="w-full min-w-[64rem] text-sm">
          <caption class="sr-only">Comparison of website platforms</caption>
          <thead class="bg-muted/40">
            <tr>
              <th scope="col" class="sticky left-0 z-10 bg-muted p-3 text-left font-semibold w-40"
                >Platform</th
              >
              {
                compareCols.map((col) => (
                  <th scope="col" class="p-3 text-left font-semibold">
                    {col}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              platforms.map((p) => (
                <tr class={`border-t align-top ${p.ours ? 'bg-primary/5' : ''}`}>
                  <th
                    scope="row"
                    class={`sticky left-0 z-10 p-3 text-left font-medium ${p.ours ? 'bg-card text-primary' : 'bg-background'}`}
                  >
                    {p.name}
                  </th>
                  {p.cells.map((cell) => (
                    <td
                      class={`p-3 leading-relaxed ${p.ours ? 'text-foreground' : 'text-muted-foreground'}`}
                    >
                      {cell}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-muted-foreground max-w-3xl">
        Prices are typical published US prices with annual billing, as of November 2026. Plans,
        prices and features change often, so check each company's own pricing page. Introductory
        prices usually rise at renewal. Self-hosted WordPress costs vary most, with hosting and
        premium plugins.
      </p>

      <div class="mt-10 max-w-2xl">
        <h3 class="text-xl font-semibold">When another platform is the better fit</h3>
        <p class="mt-3 text-muted-foreground leading-relaxed">
          I'll say so if one of these is you:
        </p>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground leading-relaxed list-disc pl-5">
          <li>
            You want to rearrange layouts and design pages yourself, often: Squarespace or Wix.
          </li>
          <li>
            You need a full online store with stock, shipping and tax: Shopify, or Square Online if
            you already use Square.
          </li>
          <li>You publish a lot and have someone to keep it updated: WordPress.</li>
          <li>You'd rather have no setup cost and accept the monthly fee.</li>
        </ul>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          If you have a site on one of these and want to move, I can carry the content across and
          keep its old addresses working.
        </p>
      </div>
    </div>
  </section>

  <TalkToJohn
    title="Moving from another platform?"
    text="Tell me where your site is now. I'll say plainly whether moving is worth it, and quote the move if it is."
  />
</BaseLayout>

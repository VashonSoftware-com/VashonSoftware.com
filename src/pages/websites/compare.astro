---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import TalkToJohn from '@/components/TalkToJohn.astro';
import WebsitesNav from '@/components/WebsitesNav.astro';
import { canDo, compareCols, platforms, type Fit, type Mark } from '@/data/websites';

// Tint plus a mark and a word, so the meaning never rests on color alone.
const markStyle: Record<Mark, { bg: string; fg: string; icon: string; label: string }> = {
  yes: { bg: 'bg-good', fg: 'text-good-foreground', icon: '✓', label: 'Yes' },
  partly: { bg: 'bg-warn', fg: 'text-warn-foreground', icon: '~', label: 'Partly' },
  no: { bg: 'bg-bad', fg: 'text-bad-foreground', icon: '✗', label: 'No' },
};

const fitStyle: Record<Fit, { mark: Mark; label: string }> = {
  built: { mark: 'yes', label: 'Built in' },
  added: { mark: 'partly', label: 'Added from a service' },
  elsewhere: { mark: 'no', label: 'Better elsewhere' },
};

// The table has ten columns, so let it use wide screens instead of scrolling sideways.
const wide = 'max-w-5xl xl:max-w-7xl 2xl:max-w-[96rem]';
---

<BaseLayout
  title="Compared with other website platforms"
  description="A built-and-owned website compared with Wix, Squarespace, GoDaddy, WordPress.com, self-hosted WordPress, Webflow, Shopify, Square Online and Google Sites: running cost, editing, moving it later, and what happens if you stop paying."
>
  <PageHeader
    title="Compared with other platforms"
    crumbs={[{ label: 'Websites', href: '/websites' }, { label: 'Compared' }]}
    width={wide}
  >
    These are good products, each best at something. The main difference is the arrangement: with a
    builder you rent the site month by month; here you pay once to have it built, then own it and
    run it nearly free.
  </PageHeader>
  <WebsitesNav width={wide} />

  <!-- Comparison -->
  <section id="compare" class="py-16 border-t" aria-label="Platform comparison">
    <div class:list={['container mx-auto px-4', wide]}>
      <div class="overflow-x-auto rounded-lg border">
        <table class="w-full min-w-[64rem] text-sm xl:text-base">
          <caption class="sr-only">Comparison of website platforms</caption>
          <thead class="bg-muted/40">
            <tr>
              <th
                scope="col"
                class="sticky left-0 z-10 bg-muted p-3 xl:p-4 text-left font-semibold w-40 xl:w-48"
                >Platform</th
              >
              {
                compareCols.map((col) => (
                  <th scope="col" class="p-3 xl:p-4 text-left font-semibold">
                    {col}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              platforms.map((p) => (
                <tr class={`border-t align-top ${p.ours ? 'bg-primary/5' : ''}`}>
                  <th
                    scope="row"
                    class={`sticky left-0 z-10 p-3 xl:p-4 text-left font-medium ${p.ours ? 'bg-card text-primary' : 'bg-background'}`}
                  >
                    {p.name}
                  </th>
                  {p.cells.map((cell) =>
                    typeof cell === 'string' ? (
                      <td
                        class={`p-3 xl:p-4 leading-relaxed ${p.ours ? 'text-foreground' : 'text-muted-foreground'}`}
                      >
                        {cell}
                      </td>
                    ) : (
                      <td class={`p-3 xl:p-4 leading-relaxed text-foreground ${markStyle[cell.mark].bg}`}>
                        <span class={`font-semibold ${markStyle[cell.mark].fg}`}>
                          <span aria-hidden="true">{markStyle[cell.mark].icon} </span>
                          {cell.label ?? markStyle[cell.mark].label}:
                        </span>{' '}
                        {cell.text}
                      </td>
                    ),
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs xl:text-sm text-muted-foreground max-w-3xl">
        Running cost is marked by the usual plan: low under $100 a year, medium $100–400, high
        $400 or more. Prices are typical published US prices with annual billing, as of November 2026. Plans,
        prices and features change often, so check each company's own pricing page. Introductory
        prices usually rise at renewal. Self-hosted WordPress costs vary most, with hosting and
        premium plugins. Care plans aren't in the table: builders keep their own software updated,
        but nobody checks your site or reports on it. My <a
          href="/websites/care-plans"
          class="underline underline-offset-4 hover:text-foreground">care plans</a
        > are optional. Speed and test scores vary from site to site on every platform; you can test
        any site, yours included, with the <a
          href="/websites#check"
          class="underline underline-offset-4 hover:text-foreground">same free tests I use</a
        >.
      </p>

      <aside
        class="mt-8 max-w-3xl rounded-lg border bg-primary/5 p-5 xl:p-6 flex flex-col sm:flex-row sm:items-center gap-4"
        aria-label="Check your own site"
      >
        <div class="flex-1">
          <h3 class="text-lg font-semibold">How does your site compare?</h3>
          <p class="mt-1 text-muted-foreground leading-relaxed">
            Check it free at How’s my site?: speed, security, accessibility, search, domain and
            email settings, and privacy, in one plain-English report. Works for a site on any
            platform; no signup, about 30 seconds.
          </p>
        </div>
        <a
          href="https://howsmy.site/"
          class="inline-flex items-center justify-center rounded-md bg-primary px-5 py-2.5 font-medium text-primary-foreground hover:bg-primary/90 whitespace-nowrap"
          >Check yours at HowsMy.Site</a
        >
      </aside>

      <div class="mt-12 max-w-4xl">
        <h3 class="text-xl font-semibold">What a built site can do, and what I pass on</h3>
        <p class="mt-3 text-muted-foreground leading-relaxed">
          Most extras connect to a service that does that one job well. Where a whole platform does
          the job better, I'll say so, and your site can still link to it.
        </p>
        <div class="mt-5 overflow-x-auto rounded-lg border">
          <table class="w-full min-w-[40rem] text-sm xl:text-base">
            <caption class="sr-only">What a built site can do itself, add from a service, or leave to another platform</caption>
            <thead class="bg-muted/40">
              <tr>
                <th scope="col" class="p-3 text-left font-semibold">You need</th>
                <th scope="col" class="p-3 text-left font-semibold w-48">Here</th>
                <th scope="col" class="p-3 text-left font-semibold">How</th>
              </tr>
            </thead>
            <tbody>
              {
                canDo.map((row) => {
                  const m = markStyle[fitStyle[row.fit].mark];
                  return (
                    <tr class="border-t align-top">
                      <th scope="row" class="p-3 text-left font-medium">
                        {row.need}
                      </th>
                      <td class={`p-3 ${m.bg}`}>
                        <span class={`font-semibold ${m.fg}`}>
                          <span aria-hidden="true">{m.icon} </span>
                          {fitStyle[row.fit].label}
                        </span>
                      </td>
                      <td class="p-3 text-muted-foreground leading-relaxed">{row.how}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          A builder may also suit you better if you want to redesign pages yourself, often
          (Squarespace or Wix), or would rather have no setup cost and pay monthly. If you have a
          site on one of these and want to move, I can carry the content across and keep its old
          addresses working.
        </p>
      </div>
    </div>
  </section>

  <TalkToJohn
    title="Moving from another platform?"
    text="Tell me where your site is now. I'll say plainly whether moving is worth it, and quote the move if it is."
  />
</BaseLayout>

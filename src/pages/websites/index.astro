---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCards from '@/components/ServiceCards.astro';
import TalkToJohn from '@/components/TalkToJohn.astro';
import WebsitesNav from '@/components/WebsitesNav.astro';
import GreenNote from '@/components/GreenNote.astro';
import {
  checkTools,
  contrastRows,
  howCards,
  offerCards,
  questions,
  results,
  steps,
  tierNames,
  whyCards,
} from '@/data/websites';

const more = [
  {
    href: '/websites/included',
    title: 'What’s included',
    text: 'The foundations every site gets (ownership, history, speed, security, monitoring, email), and the options you can add.',
  },
  {
    href: '/websites/care-plans',
    title: 'Care plans',
    text: 'Optional check-ups from $10 a month: automated reports and backups, or a person checking your site and making small changes.',
  },
  {
    href: '/websites/compare',
    title: 'Compared with other platforms',
    text: 'Wix, Squarespace, WordPress, Shopify and others side by side: running cost, who changes it, and what happens if you stop paying.',
  },
];
---

<BaseLayout
  title="Websites"
  description="Small-business websites from Vashon Software: owned by you, fast everywhere, built with modern tools, looked after by a real person. How that differs from Wix or Squarespace, what's included, care plans, and a 'which approach fits?' quiz."
>
  <PageHeader title="Websites, made simple" eyebrow="Websites">
    Whether you're starting from scratch, freshening up an old site, or just wondering what's
    possible, you're in the right place. I build and look after websites for small businesses and
    nonprofits, and explain everything in plain English. No jargon, no pressure.
  </PageHeader>
  <WebsitesNav />

  <!-- Welcome: a guide to what's on offer -->
  <section id="offer" class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="section-title">What I can help with</h2>
        <p class="mt-2 text-muted-foreground">Pick whichever sounds most like you.</p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          offerCards.map((c) => (
            <a
              href={c.href}
              class="group rounded-lg border bg-card p-6 hover:shadow-md transition-shadow"
            >
              <h3 class="font-semibold text-lg group-hover:text-primary transition-colors">
                {c.title}
              </h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{c.text}</p>
              <span class="mt-4 inline-block text-sm font-medium text-primary">{c.link} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="steps" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="section-title">How it works</h2>
        <p class="mt-2 text-muted-foreground">
          You don't need to know anything technical. That part's my job.
        </p>
      </div>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="rounded-lg border bg-card p-6">
              <span
                class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary text-primary-foreground text-sm font-semibold"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="mt-3 font-semibold text-lg">{s.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why it's different -->
  <section id="why" class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="section-title">What makes my sites different</h2>
        <p class="mt-2 text-muted-foreground">
          Wix, Squarespace and the rest are quick to start, and for some people they're the right
          choice. The trade-offs tend to show up later, when you want to move, speed up, or get
          help.
        </p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          whyCards.map((c) => (
            <article id={`why-${c.slug}`} class="rounded-lg border bg-card p-6">
              <h3 class="font-semibold text-lg">{c.title}</h3>
              <p class="mt-1 text-sm font-medium text-primary">{c.lead}</p>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{c.text}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-10 overflow-x-auto rounded-lg border">
        <table class="w-full text-sm">
          <caption class="sr-only"
            >A site builder compared with a site built and owned by you</caption
          >
          <thead class="bg-muted/40 text-left">
            <tr>
              <th scope="col" class="p-3 font-medium"><span class="sr-only">Question</span></th>
              <th scope="col" class="p-3 font-medium">Drag-and-drop builder</th>
              <th scope="col" class="p-3 font-medium">Built and owned</th>
            </tr>
          </thead>
          <tbody>
            {
              contrastRows.map(([label, builder, owned]) => (
                <tr class="border-t">
                  <th scope="row" class="p-3 text-left font-medium align-top">
                    {label}
                  </th>
                  <td class="p-3 text-muted-foreground align-top">{builder}</td>
                  <td class="p-3 align-top">{owned}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">
        Platform by platform, with running costs: <a
          href="/websites/compare"
          class="underline underline-offset-4 text-foreground">compared with other platforms</a
        >. Everything every site gets: <a
          href="/websites/included"
          class="underline underline-offset-4 text-foreground">what's included</a
        >.
      </p>
      <GreenNote class="mt-6" />
    </div>
  </section>

  <!-- Quiz -->
  <section id="fit" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="section-title">Looking for a new or updated website?</h2>
        <p class="mt-2 text-muted-foreground">
          If so, five quick questions will suggest an approach that suits you. It may well be a
          platform other than mine, and that's fine: the aim is to help you choose well. Your
          answers stay in your browser.
        </p>
      </div>
      <details id="fit-details" class="group mt-6">
        <summary
          class="inline-flex cursor-pointer list-none items-center justify-center rounded-md text-sm font-medium h-10 px-5 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">Yes, let's look at the questions</span>
          <span class="hidden group-open:inline">Hide the questions</span>
        </summary>
        <form
          id="fit-form"
          class="mt-8 grid gap-6 lg:grid-cols-[1fr_22rem]"
          onsubmit="return false"
        >
          <div class="space-y-6">
            {
              questions.map((question, qi) => (
                <fieldset class="rounded-lg border bg-card p-5">
                  <legend class="px-1 font-semibold">
                    {qi + 1}. {question.q}
                  </legend>
                  <div class="mt-3 grid gap-2">
                    {question.answers.map((a, ai) => (
                      <label class="flex items-start gap-3 rounded-md border px-3 py-2 text-sm cursor-pointer hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                        <input
                          type="radio"
                          name={question.id}
                          value={ai}
                          class="mt-1 accent-primary"
                          data-pts={JSON.stringify(a.pts)}
                          data-tier={a.tier ?? ''}
                        />
                        <span>{a.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))
            }
          </div>
          <aside
            class="lg:sticky lg:top-24 self-start rounded-lg border bg-card p-6"
            aria-live="polite"
          >
            <h3 class="text-sm font-medium uppercase tracking-wide text-muted-foreground">
              Suggested approach
            </h3>
            <div id="fit-empty" class="mt-3 text-sm text-muted-foreground">
              Answer the questions to see a suggestion. <span id="fit-count">0</span> of {
                questions.length
              } answered.
            </div>
            <div id="fit-result" class="mt-3 hidden">
              <p id="fit-title" class="text-xl font-semibold"></p>
              <p id="fit-why" class="mt-2 text-sm text-muted-foreground leading-relaxed"></p>
              <p id="fit-tier" class="mt-2 text-sm hidden"></p>
              <p id="fit-next" class="mt-3 text-sm"></p>
              <p class="mt-4 text-sm text-muted-foreground">
                Also worth a look: <span id="fit-runner" class="font-medium text-foreground"></span>
              </p>
              <a
                id="fit-cta"
                href="/about#contact"
                class="mt-5 inline-flex items-center justify-center rounded-md text-sm font-medium h-10 px-5 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
                >Talk it over</a
              >
              <p class="mt-4 text-xs text-muted-foreground">
                A starting point, not a verdict. Your answers stay in your browser.
              </p>
            </div>
          </aside>
        </form>
      </details>
    </div>
  </section>

  <!-- The other Websites pages -->
  <section class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <SectionHeader title="More detail" class="mb-10" />
      <div class="grid gap-6 md:grid-cols-3">
        {
          more.map((m) => (
            <a
              href={m.href}
              class="group rounded-lg border bg-card p-6 hover:shadow-md transition-shadow"
            >
              <h3 class="font-semibold text-lg mb-2 group-hover:text-primary transition-colors">
                {m.title} →
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{m.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Check your site -->
  <section id="check" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="section-title">Check your current site</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          To look for yourself, these free tools run the same core tests as the health check. Paste
          in your address.
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          checkTools.map((t) => (
            <a
              href={t.url}
              rel="noopener"
              target="_blank"
              class="rounded-lg border bg-card p-5 hover:shadow-md transition-shadow"
            >
              <span class="font-semibold">{t.name} ↗</span>
              <span class="block text-xs text-muted-foreground">{t.by}</span>
              <span class="mt-2 block text-sm text-muted-foreground">Checks {t.what}.</span>
            </a>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted-foreground max-w-2xl">
        Every proposal I write starts with a full health check of your current site, free: the
        scores, what's already good, and what needs fixing, in plain English. After launch the same
        checks show the before and after. <a
          href="/about#contact"
          class="underline underline-offset-4 text-foreground">Ask for a proposal</a
        >.
      </p>
    </div>
  </section>

  <section id="how" class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <SectionHeader title="How I build them" class="mb-10" />
      <ServiceCards cards={howCards} />
    </div>
  </section>

  <TalkToJohn
    title="Want to talk about your site?"
    text="Tell me what you have now and what you'd like it to do. I'll reply with a plain written quote."
  />
</BaseLayout>

<script define:vars={{ results, tierNames, total: questions.length }}>
  const form = document.getElementById('fit-form');
  const $ = (id) => document.getElementById(id);
  function update() {
    const checked = [...form.querySelectorAll('input[type=radio]:checked')];
    $('fit-count').textContent = String(checked.length);
    if (checked.length < total) {
      $('fit-empty').classList.remove('hidden');
      $('fit-result').classList.add('hidden');
      return;
    }
    const score = {};
    const tiers = [];
    for (const input of checked) {
      const pts = JSON.parse(input.dataset.pts || '{}');
      for (const [k, v] of Object.entries(pts)) score[k] = (score[k] || 0) + v;
      if (input.dataset.tier) tiers.push(input.dataset.tier);
    }
    const ranked = Object.keys(results).sort((a, b) => (score[b] || 0) - (score[a] || 0));
    const top = results[ranked[0]];
    $('fit-title').textContent = top.title;
    $('fit-why').textContent = top.why;
    $('fit-next').textContent = top.next;
    $('fit-runner').textContent = results[ranked[1]].title;
    const tierEl = $('fit-tier');
    if (ranked[0] === 'owned' && tiers.length) {
      // The highest tier any answer implies (C > B > A).
      const tier = tiers.sort().at(-1);
      tierEl.textContent = tierNames[tier];
      tierEl.classList.remove('hidden');
    } else {
      tierEl.classList.add('hidden');
    }
    $('fit-empty').classList.add('hidden');
    $('fit-result').classList.remove('hidden');
  }
  form.addEventListener('change', update);
  update();

  // Links to #fit (from the "What I can help with" cards, or elsewhere) open the questions.
  const details = $('fit-details');
  const openFit = () => {
    if (location.hash === '#fit') details.open = true;
  };
  window.addEventListener('hashchange', openFit);
  document.querySelectorAll('a[href="#fit"]').forEach((a) =>
    a.addEventListener('click', () => {
      details.open = true;
    })
  );
  openFit();
</script>

<script is:inline>
  // Sections that moved to their own pages; keeps old /websites#... links working.
  (() => {
    const moved = {
      included: '/websites/included',
      options: '/websites/included#options',
      ownership: '/websites/included#ownership',
      history: '/websites/included#history',
      speed: '/websites/included#speed',
      security: '/websites/included#security',
      monitoring: '/websites/included#monitoring',
      email: '/websites/included#email',
      care: '/websites/care-plans',
      compare: '/websites/compare',
    };
    const to = moved[location.hash.slice(1)];
    if (to) location.replace(to);
  })();
</script>

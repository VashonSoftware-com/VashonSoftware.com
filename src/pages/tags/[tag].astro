---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostRow from '@/components/blog/PostRow.astro';
import { getPublishedPosts, sortNewestFirst } from '@/lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { posts: sortNewestFirst(allPosts.filter((post) => post.data.tags.includes(tag))) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`Posts tagged "${tag}"`} description={`All blog posts tagged with ${tag}`}>
  <div class="container max-w-4xl mx-auto py-12 sm:py-16">
    <header class="mb-8">
      <a
        href="/tags/"
        class="inline-flex items-center text-sm text-muted-foreground hover:text-primary mb-4 transition-colors"
      >
        ← All tags
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">
        Posts tagged <span class="text-primary">#{tag}</span>
      </h1>
      <p class="text-sm text-muted-foreground">
        {posts.length}
        {posts.length === 1 ? 'post' : 'posts'} ·
        <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="underline hover:text-primary"
          >search and sort these on the blog page</a
        >
      </p>
    </header>

    <div class="divide-y divide-border">
      {posts.map((post) => <PostRow post={post} tagHref={(t) => `/tags/${t}/`} />)}
    </div>
  </div>
</BaseLayout>

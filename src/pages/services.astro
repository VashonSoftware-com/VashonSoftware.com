---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/sections/CTA.astro';

const localProjects = [
  { title: 'Website refresh or fix', desc: "Update an existing site, fix what's broken" },
  { title: 'New small site', desc: 'One-page to five-page business or portfolio site' },
  { title: 'Tech consult', desc: 'An hour or two to get your project pointed in the right direction' },
  { title: 'Custom script or tool', desc: "Automate something that's wasting your time" },
  { title: 'Emergency / off-hours help', desc: 'When something breaks and you need it fixed fast' },
];

const serviceGroups = [
  {
    category: 'Websites',
    slug: 'websites',
    description: 'Modern low-JS, static mobile-first sites with proven 100 PageSpeed scores for Performance, Accessibility, Best Practices & SEO.',
    services: [
      {
        title: 'Performance-First Static Sites',
        description:
          'Reliable Svelte and Angular component-focused solutions using Astro, Eleventy, Hugo, Decap, Nunjucks, HTML5, CSS3+, TypeScript, and Markdown — with modern versioning & CI/CD pipelines.',
      },
      {
        title: 'Creative Design & User Editable',
        description:
          'Creative design that your team can manage and update without developer involvement — all at an economical price.',
      },
      {
        title: 'Example Sites',
        description:
          'VashonSoftware.com, eoc.online, Mesh101.com, VashonMesh.com, MadeInParadiseRocks.com, VashonTaiChi.com, VashonMassage.com, Cornelisons.com, VashonBePrepared, VashonEOC, and many others over the years.',
      },
    ],
  },
  {
    category: 'Crafted Software',
    slug: 'crafted-software',
    description:
      'Custom applications engineered with modern architectures and technologies to meet your exact requirements.',
    services: [
      {
        title: 'Microservices & Containerized Systems',
        description:
          'Microservices-based architectural design on containerized systems — scalable, maintainable, and built for long-term operation.',
      },
      {
        title: 'Custom Applications',
        description:
          'Bespoke software using C#, TypeScript, Python, C++, pnpm, SQL & NoSQL — designed around your workflows and delivered with clean, maintainable code.',
      },
      {
        title: 'Artificial Intelligence',
        description:
          'Small Language Models (SLMs) applied to GIS & Geomatics, IoT, and domain-specific problem solving — practical AI without the overhead.',
      },
      {
        title: 'Secure IoT Development',
        description:
          'End-to-end IoT solutions with security designed in from the ground up — from edge devices to data pipelines.',
      },
      {
        title: 'Data Analytics',
        description:
          'Data analytics solutions deployed across a variety of cloud platforms — turning raw data into actionable insight.',
      },
      {
        title: 'Healthcare IT',
        description:
          'Deep experience in health information exchange, clinical systems integration, and federal health architecture — including Epic gateway (via InterSystems HealthShare/MultiCare), CONNECT, HL7, C32/CCD, and AHLTA.',
      },
    ],
  },
  {
    category: 'Disaster Technology',
    slug: 'disaster-technology',
    description:
      'Mission-critical software for Emergency Operations Centers — resilient by design, reliable when it matters most.',
    services: [
      {
        title: 'Emergency Operations Centers',
        description:
          'Software solutions focused on small & international EOCs — systems that are NOT reliant on the cloud but can leverage those abilities when the Internet is available, even intermittently.',
      },
      {
        title: 'ICS / NIMS / NRF Based Solutions',
        description:
          'Incident Command System (ICS), National Incident Management System (NIMS) & National Response Framework (NRF) compliant platforms for structured emergency response.',
      },
      {
        title: 'Emergency Response Systems',
        description:
          'Coordination tools and communication platforms built for high-stress, high-stakes situations where reliability is non-negotiable.',
      },
      {
        title: 'Data Recovery Solutions',
        description:
          'Automated backup pipelines and recovery workflows ensuring your data and services can be restored quickly after any incident.',
      },
      {
        title: 'Risk Assessment Tools',
        description:
          'Tools for identifying, evaluating, and mitigating risks before they become incidents — built for operational teams in the field.',
      },
    ],
  },
];
---

<BaseLayout
  title="Services — Vashon Software"
  description="Vashon Software services: websites, custom applications, disaster tech, and small local projects. Serving Vashon Island and the greater Seattle area since 2010."
>
  <!-- Page Header -->
  <section class="py-20 md:py-28">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">Services</h1>
        <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
          I've been at this since 2010 — finding the right tech for the job, not just the
          trendiest one. Agile, modular, and built to grow, minus the buzzword bingo. Whether
          it's a five-page site or a multi-service architecture, I keep it creative, simple, and
          built to last.
        </p>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          I'm John Cornelison — principal architect and one-person shop — bringing 30+ years
          across healthcare IT, emergency management, and commercial software to every engagement.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            Discuss Your Project
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Healthcare IT & Architecture Modernization -->
  <section id="health-it" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold md:text-3xl">Healthcare IT &amp; Architecture Modernization</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          Thirty years of enterprise architecture experience — including hands-on work inside
          federal health systems, health information exchanges, and clinical EHR integrations.
          Available for senior consulting, staff augmentation, and architecture advisory roles.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-lg border bg-card p-6">
          <h3 class="font-semibold text-lg mb-4">Health IT &amp; Interoperability</h3>
          <ul class="space-y-3 text-sm text-muted-foreground leading-relaxed">
            <li>
              <span class="font-medium text-foreground">HIE Architecture &amp; Leadership</span> —
              Technical lead for the South Sound Health Information Exchange (SSHIE); architecture,
              ONC onboarding compliance, partner communications, NHIN briefings, and use case
              specification.
            </li>
            <li>
              <span class="font-medium text-foreground">EHR Integration</span> — Direct
              integration-layer work with Epic's gateway (via InterSystems HealthShare/MultiCare at
              Madigan), AHLTA, Essentris, CHCS, and GE Centricity PACS. Hands-on, not adjacent.
            </li>
            <li>
              <span class="font-medium text-foreground">Clinical Interoperability Standards</span> —
              HL7, C32/CCD/C84/C62, NwHIN/NHIN Direct, CONNECT. Designed ED-specific document
              exchange use cases: C32 on patient arrival, C84/C62 on discharge.
            </li>
            <li>
              <span class="font-medium text-foreground">SSO &amp; Context Management</span> —
              Microsoft/Sentillion CCOW-compliant single sign-on across disconnected clinical
              systems; DoD CAC smart card integration (MiCARE PHR).
            </li>
            <li>
              <span class="font-medium text-foreground">Federal &amp; Regulated Environments</span> —
              DIACAP, SDL, DOJ SDLC, TATRC-funded projects. Comfortable in VA, DoD, and
              federal-adjacent health IT contexts.
            </li>
          </ul>
          <p class="mt-4 text-xs text-muted-foreground">
            HIMSS member · MS-HUG (Microsoft Healthcare Users Group) member · CONNECT-a-thon
            participant
          </p>
        </div>

        <div class="rounded-lg border bg-card p-6">
          <h3 class="font-semibold text-lg mb-4">Architecture Modernization</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4">
            Experienced in the full socio-technical scope of modernization — not just the
            technology, but the organizational alignment, domain modeling, and change management
            that make it stick.
          </p>
          <ul class="space-y-3 text-sm text-muted-foreground leading-relaxed">
            <li>
              <span class="font-medium text-foreground">Domain-Driven Design (DDD)</span> — Bounded
              contexts, domain events, and strategic design to decompose legacy monoliths into
              maintainable, independently deployable services.
            </li>
            <li>
              <span class="font-medium text-foreground">EventStorming &amp; Domain Discovery</span> —
              Collaborative workshops to surface domain models, identify boundaries, and build
              shared understanding across technical and business teams.
            </li>
            <li>
              <span class="font-medium text-foreground">Team Topologies</span> — Aligning team
              structures and interaction modes with software architecture for sustainable delivery.
              Conway's Law applied intentionally.
            </li>
            <li>
              <span class="font-medium text-foreground">Microservices &amp; API Architecture</span> —
              MEAN/.NET stacks, Docker/Kubernetes, Azure/AWS/GCP. Enterprise integration patterns,
              BizTalk SOA message brokering, and modern API design.
            </li>
            <li>
              <span class="font-medium text-foreground">Cloud Migration &amp; Modernization</span> —
              Azure, AWS, and Google Cloud; CI/CD pipelines; Cloudflare Pages and Workers for modern
              edge-deployed architectures.
            </li>
            <li>
              <span class="font-medium text-foreground">AI/LLM Integration</span> — Active, current
              experience evaluating and integrating Copilot, Claude, GPT, and Gemini into
              development and operational workflows. Early work on an emergency-management LLM
              ontology.
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-6 rounded-lg border bg-card p-6">
        <h3 class="font-semibold text-lg mb-3">Representative Work</h3>
        <ul class="space-y-2 text-sm text-muted-foreground leading-relaxed">
          <li>Implemented Federal Health Architecture for Franciscan, MultiCare &amp; Madigan Regional HIO</li>
          <li>Designed the MERIT message broker architecture for WRMC (BizTalk SOA)</li>
          <li>Contributed to the Phuket Provincial Intelligent Operations Center architecture</li>
          <li>Built and maintains EOC.online — open-source microservice platform for emergency operations</li>
        </ul>
      </div>

      <div class="mt-6 max-w-2xl">
        <h3 class="font-semibold text-lg mb-3">How to Engage</h3>
        <ul class="space-y-2 text-sm text-muted-foreground leading-relaxed">
          <li>
            <span class="font-medium text-foreground">Senior consulting &amp; staff augmentation</span>
            — architecture advisory, technical lead, hands-on development
          </li>
          <li>
            <span class="font-medium text-foreground">Architecture reviews &amp; second opinions</span>
            — assess what you have, recommend a path
          </li>
          <li>
            <span class="font-medium text-foreground">Short-term &amp; project-based</span> —
            discovery sprints, proof-of-concept work, targeted fixes
          </li>
          <li>
            <span class="font-medium text-foreground">Healthcare IT contract roles</span> — HIE, EHR
            integration, federal health systems
          </li>
        </ul>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center justify-center rounded-md text-sm font-medium h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Contact John
        </a>
      </div>
    </div>
  </section>

  <!-- Small & Local Projects -->
  <section class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold md:text-3xl">Small &amp; Local Projects</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          Need something smaller? I take on one-off and short-term engagements for local businesses,
          nonprofits, and individuals:
        </p>
        <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
          {localProjects.map((item) => (
            <li><span class="font-medium text-foreground">{item.title}</span> — {item.desc}</li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-muted-foreground">
          Reach out and describe what you need. Most small projects get a same-week response.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center justify-center rounded-md text-sm font-medium h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Contact John
        </a>
      </div>
    </div>
  </section>

  <!-- Service Groups -->
  {
    serviceGroups.map((group) => (
      <section id={group.slug} class="py-16 border-t">
        <div class="container max-w-5xl mx-auto px-4">
          <div class="mb-10">
            <h2 class="text-2xl font-bold md:text-3xl">{group.category}</h2>
            <p class="mt-2 text-muted-foreground">{group.description}</p>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.services.map((service) => (
              <div class="rounded-lg border bg-card p-6 hover:shadow-md transition-shadow">
                <h3 class="font-semibold text-lg mb-2">{service.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{service.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CTA
    title="Have a project in mind?"
    description="I'd love to hear about it — reach out and let's talk about what we can build together."
    cta={{ href: '/contact', label: 'Get in Touch' }}
  />
</BaseLayout>

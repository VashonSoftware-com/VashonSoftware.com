---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/sections/CTA.astro';

// What every small-business site includes, grouped so a reader can scan by concern.
const included = [
  {
    title: 'You own it',
    slug: 'ownership',
    items: [
      ['Your domain, in your name', 'Registered at cost, with auto-renew on. Owner privacy (your name and address hidden from public look-ups) is included free.'],
      ['Your accounts, or mine on your behalf', 'The site can live in your own free GitHub and Cloudflare accounts, with me as an administrator, or I can run it for you. You can switch later.'],
      ['Your files', 'The site is ordinary, readable files (HTML, CSS, Markdown), not a format tied to one company. Any web developer can pick it up, and you can move it anywhere.'],
      ['No platform licence', 'Nothing to keep paying a builder for, and nothing lost if you stop paying me.'],
    ],
  },
  {
    title: 'Nothing gets lost',
    slug: 'history',
    items: [
      ['A full change history', 'Every change, yours or mine, is recorded with its date (git). Any earlier version can be looked at or put back.'],
      ['Backups kept elsewhere', 'Besides the copy at GitHub, a backup is kept on separate storage (on a care plan).'],
      ['Old links keep working', 'When moving from an old site, every old page address is sent on to its new page, so search results and bookmarks still work.'],
      ['The old site stays as a fallback', 'Until the new one is live and checked.'],
    ],
  },
  {
    title: 'Fast and easy to find',
    slug: 'speed',
    items: [
      ['Fast on phones', 'Target of 95+ in Google PageSpeed for speed, accessibility, best practices and SEO, measured before launch.'],
      ['Search-engine basics done', 'Page titles and descriptions, a sitemap, tidy addresses and sharing previews for Facebook, LinkedIn and texts.'],
      ['Accessible', 'Built to WCAG 2.2 AA: readable contrast, keyboard use, screen-reader labels. Light and dark mode.'],
      ['Served worldwide', 'Hosted on Cloudflare’s network, free at small-site sizes.'],
    ],
  },
  {
    title: 'Secure by default',
    slug: 'security',
    items: [
      ['HTTPS, renewed automatically', 'The padlock in the address bar, with nothing to renew by hand.'],
      ['Nothing to patch', 'No server, database or plugins for anyone to break into or keep updated.'],
      ['Spam-protected contact form', 'Messages come to your email. Your address and phone are hidden from scrapers.'],
      ['Security headers and a privacy page', 'The page says plainly what the site collects (usually very little).'],
    ],
  },
  {
    title: 'You know how it’s doing',
    slug: 'monitoring',
    items: [
      ['Visitor statistics without cookies', 'So no cookie banner is needed.'],
      ['A monthly visitor email', 'Visits, top pages and where people came from, in plain numbers.'],
      ['Watched automatically', 'An uptime monitor, an alert if an update fails to publish, and a weekly check for broken links to other sites.'],
    ],
  },
  {
    title: 'Email and domains',
    slug: 'email',
    items: [
      ['Email at your domain', 'you@yourbusiness.com, forwarded to the inbox you already use.'],
      ['Extra domains', 'Other names you own (misspellings, old names) are sent to the main site.'],
    ],
  },
];

const options = [
  {
    title: 'Editing it yourself',
    items: [
      ['Browser editor', 'Change words, photos and lists from any browser, with no software to install. Each save is recorded in the change history, so a mistake can be undone.'],
      ['Site tools page', 'A small private admin page for your site: open the editor, see whether your last change published, recent site checks, and a button to report a problem or ask for a change.'],
      ['Editing guide', 'Written around your own pages, with screenshots.'],
    ],
  },
  {
    title: 'More on the site',
    items: [
      ['Full-site search', ''],
      ['Blog or news section, with tags', ''],
      ['Extra forms', 'Orders, booking requests, sign-ups.'],
      ['Payment buttons', 'Stripe or PayPal, for a few products or deposits. Larger stores: see the comparison.'],
      ['Booking', 'Linking or embedding Calendly, Square and the like.'],
      ['Mailing-list sign-up', ''],
      ['A collection or catalogue', 'Items with tags and filters, a page for each, bulk photo upload.'],
      ['Members-only or family pages', 'Behind a sign-in.'],
      ['A second language', ''],
    ],
  },
  {
    title: 'Email and other work',
    items: [
      ['A full mailbox at your domain', 'On a small, reliable mail host, for about $10 a year; or Google Workspace at Google’s price.'],
      ['Moving old mail across', ''],
      ['A new design or restyle', ''],
      ['Writing or entering content', 'Typing, photo editing, captions.'],
      ['Rescuing a lost site', 'Rebuilding from the Internet Archive when the old host or login is gone.'],
    ],
  },
];

// Care plans. ✓ / — / text per column.
const careCols = ['No plan', 'Yearly', 'Quarterly', 'Total care (monthly)'];
const careRows: { label: string; cells: string[] }[] = [
  { label: 'Site keeps running, monthly visitor email, automatic alerts', cells: ['✓', '✓', '✓', '✓'] },
  { label: 'Full health check (below)', cells: ['—', 'Yearly', 'Quarterly', 'Monthly'] },
  { label: 'Software updates', cells: ['—', 'Yearly', 'Quarterly', 'Monthly'] },
  { label: 'Backup kept off GitHub, test-restored', cells: ['—', 'Yearly', 'Quarterly', 'Monthly'] },
  { label: 'Short written report', cells: ['—', 'Yearly', 'Quarterly', 'Monthly'] },
  { label: 'Call to talk it over', cells: ['—', 'Yearly', 'Yearly', 'Quarterly'] },
  { label: 'Change time included', cells: ['Billed hourly', '1 hour a year', '2 hours a year', '1 hour a month'] },
  { label: 'When something breaks', cells: ['Hourly, best effort', 'Best effort', 'Best effort', 'Next working day'] },
];

const healthCheck = [
  ['Speed', 'Google PageSpeed on phone and desktop, compared with last time.'],
  ['Accessibility', 'Automated WCAG checks plus a keyboard and screen-reader spot check.'],
  ['Security', 'HTTPS certificate, security-header grade, nothing exposed that shouldn’t be.'],
  ['Links and forms', 'Broken links, a test message through each form.'],
  ['Search', 'Sitemap, page titles, sharing previews, Google Search Console warnings.'],
  ['Renewals', 'Domain and certificate dates, so nothing lapses.'],
  ['Backups', 'A fresh off-site copy, and a test that it restores.'],
];

const checkTools = [
  { name: 'PageSpeed Insights', by: 'Google', url: 'https://pagespeed.web.dev/', what: 'speed, accessibility, SEO basics' },
  { name: 'HTTP Observatory', by: 'Mozilla (MDN)', url: 'https://developer.mozilla.org/en-US/observatory', what: 'security headers' },
  { name: 'SSL Server Test', by: 'Qualys SSL Labs', url: 'https://www.ssllabs.com/ssltest/', what: 'the HTTPS certificate and its setup' },
];

// Platform comparison. Typical published US prices, annual billing, November 2026.
const compareCols = ['Typical running cost', 'Up-front', 'Who changes it', 'Moving it later', 'If you stop paying', 'Who keeps it updated and secure', 'Best for'];
const platforms: { name: string; ours?: boolean; cells: string[] }[] = [
  {
    name: 'Built and owned (this page)',
    ours: true,
    cells: ['Hosting $0; a .com about $11/yr; optional care plan', 'Setup, quoted in writing', 'You (words, photos) or me; layout changes by me', 'Copy the files to any host', 'Keeps running; just renew the domain', 'Nothing to patch; checked on a care plan', 'Small businesses wanting low running costs, ownership and a person to call'],
  },
  {
    name: 'Wix',
    cells: ['About $17–39/mo', 'None (you build it)', 'You, drag-and-drop', 'Classic sites can’t be exported', 'Falls back to a Wix address with ads', 'Wix', 'People who enjoy designing their own pages'],
  },
  {
    name: 'Squarespace',
    cells: ['About $16–39/mo', 'None (you build it)', 'You, drag-and-drop', 'Partial: pages and posts; design is rebuilt', 'Site goes offline', 'Squarespace', 'Polished portfolios and small shops'],
  },
  {
    name: 'GoDaddy builder',
    cells: ['About $10–15/mo to start; more at renewal', 'None (you build it)', 'You, simple editor', 'No export', 'Site goes offline', 'GoDaddy', 'A quick, simple first site'],
  },
  {
    name: 'WordPress.com',
    cells: ['About $4–25/mo; more for a store', 'None (you build it)', 'You, block editor', 'Exports to any WordPress host', 'Drops to the free plan (ads, no own domain)', 'WordPress.com', 'Blogs and writing-heavy sites'],
  },
  {
    name: 'WordPress, self-hosted',
    cells: ['About $200–800/yr for hosting, theme and plugins', 'Often a developer', 'You, block editor', 'Moves to any WordPress host', 'Offline when hosting lapses', 'You or a paid maintainer: regular core, theme and plugin updates', 'Large content sites with someone to maintain them'],
  },
  {
    name: 'Webflow',
    cells: ['From about $15/mo per site', 'Usually a designer', 'A designer; you edit content', 'Partial: code export, content as CSV', 'Custom domain stops working', 'Webflow', 'Design-led sites built by a designer'],
  },
  {
    name: 'Shopify',
    cells: ['From $29/mo, plus card fees', 'None, or a developer', 'You', 'Products and orders export; design doesn’t', 'Store closes', 'Shopify', 'Real online stores: stock, shipping, tax'],
  },
  {
    name: 'Square Online',
    cells: ['Free plan (Square branding), or from $49/mo; card fees', 'None (you build it)', 'You', 'No site export', 'Free plan continues', 'Square', 'Shops and cafés already using Square'],
  },
  {
    name: 'Google Sites',
    cells: ['Free; domain extra', 'None (you build it)', 'You, simple editor', 'No usable export', 'Free', 'Google', 'Clubs, classes and simple internal pages'],
  },
];

// "Which approach fits?" questions. Each answer adds points to approaches; highest wins.
type Key = 'owned' | 'builder' | 'wpcom' | 'wpself' | 'webflow' | 'shopify' | 'square' | 'gsites';
const questions: { id: string; q: string; answers: { label: string; pts: Partial<Record<Key, number>>; tier?: string }[] }[] = [
  {
    id: 'purpose',
    q: 'What does the site mainly need to do?',
    answers: [
      { label: 'Tell people who we are and how to reach us', pts: { owned: 3, builder: 2, gsites: 1, wpcom: 1 }, tier: 'A' },
      { label: 'Show a portfolio, gallery or catalogue', pts: { owned: 3, builder: 2, webflow: 1 }, tier: 'C' },
      { label: 'Publish articles or news often', pts: { wpcom: 3, wpself: 2, owned: 2, builder: 1 } },
      { label: 'Sell many products online', pts: { shopify: 7, builder: 2, square: 2, owned: -2 } },
      { label: 'Take orders for a shop or café already on Square', pts: { square: 5, shopify: 1 } },
    ],
  },
  {
    id: 'editor',
    q: 'Who will make changes?',
    answers: [
      { label: 'Rarely needed; someone else can do it', pts: { owned: 3 }, tier: 'A' },
      { label: 'Me: words and photos', pts: { owned: 2, builder: 2, wpcom: 2, shopify: 1, square: 1 }, tier: 'B' },
      { label: 'Me: I want to redesign pages often', pts: { builder: 4, wpcom: 2, webflow: 1, square: 1, shopify: 1, owned: -2 } },
      { label: 'A web designer or a team', pts: { webflow: 5, owned: 2, wpself: 2 } },
    ],
  },
  {
    id: 'money',
    q: 'How would you rather pay?',
    answers: [
      { label: 'Once to build it, then very little', pts: { owned: 3, wpself: 1, gsites: 2 } },
      { label: 'A monthly fee, with no setup cost', pts: { builder: 3, wpcom: 2, square: 2, shopify: 1, gsites: 1, owned: -2 } },
      { label: 'Either is fine', pts: {} },
    ],
  },
  {
    id: 'own',
    q: 'How much does owning it, and being free to move it, matter?',
    answers: [
      { label: 'A lot', pts: { owned: 3, wpself: 3, wpcom: 1, builder: -2, gsites: -1, square: -1 } },
      { label: 'Somewhat', pts: { owned: 1, wpself: 1 } },
      { label: 'Not much', pts: { builder: 1, gsites: 1 } },
    ],
  },
  {
    id: 'upkeep',
    q: 'Who should look after updates and security?',
    answers: [
      { label: 'Someone else, please', pts: { owned: 3, builder: 1, shopify: 1, square: 1, wpself: -3 } },
      { label: 'I can follow instructions', pts: { builder: 1, wpcom: 1, gsites: 1 } },
      { label: 'I’m happy to run updates myself', pts: { wpself: 3, webflow: 1 } },
    ],
  },
];

const results: Record<Key, { title: string; why: string; next: string; href?: string }> = {
  owned: { title: 'A site built for you, and owned by you', why: 'Low running costs, nothing to patch, and a person to call. You pay once for the build.', next: 'See what’s included below, then get in touch for a quote.', href: '/contact' },
  builder: { title: 'A site builder: Squarespace or Wix', why: 'You want to design and rearrange pages yourself and prefer a monthly fee to a setup cost.', next: 'Squarespace for polish, Wix for flexibility. I can help set one up or move content in.' },
  wpcom: { title: 'WordPress.com', why: 'Good for regular writing, with an export path to any WordPress host later.', next: 'Start on a paid plan so you can use your own domain.' },
  wpself: { title: 'Self-hosted WordPress', why: 'Maximum control and a huge plugin choice, if someone keeps it updated.', next: 'Budget for good hosting and regular updates, or a maintenance plan.' },
  webflow: { title: 'Webflow, with a designer', why: 'A design-led site where a designer builds it and you edit the content.', next: 'Hire a Webflow designer; ask about code export before you start.' },
  shopify: { title: 'Shopify', why: 'Stock, shipping and tax are its job. Custom work rarely beats it for a real store.', next: 'Start on Basic. A built-and-owned site can link to the store if you want both.' },
  square: { title: 'Square Online', why: 'If you already take payments with Square, the online shop connects to it directly.', next: 'Try the free plan first.' },
  gsites: { title: 'Google Sites', why: 'Free and simple, good enough for a club, class or internal page.', next: 'Add your own domain for a few dollars a year.' },
};

const tierNames: Record<string, string> = {
  A: 'Most likely the Essentials package: I make changes on request.',
  B: 'Most likely the Self-edit package: you change words and photos in the browser.',
  C: 'Most likely the Collection package: items with tags, filters and a page each.',
};
---

<BaseLayout
  title="What a Vashon Software website includes"
  description="What every small-business website from Vashon Software includes, the options and care plans, a quick 'which approach fits?' quiz, and a comparison with Wix, Squarespace, WordPress, Shopify and other builders."
>
  <!-- Header -->
  <section class="py-20 md:py-24">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <p class="text-sm font-medium text-muted-foreground"><a href="/services" class="hover:underline">Services</a> / Websites</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">What your website includes</h1>
        <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
          Every small site I build comes with the same foundations. They cost little once set up,
          so they aren't sold as extras. Beyond that, you pick only the options you need.
        </p>
        <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="#fit" class="underline underline-offset-4 hover:text-foreground text-muted-foreground">Which approach fits you?</a>
          <a href="#included" class="underline underline-offset-4 hover:text-foreground text-muted-foreground">Always included</a>
          <a href="#options" class="underline underline-offset-4 hover:text-foreground text-muted-foreground">Options</a>
          <a href="#care" class="underline underline-offset-4 hover:text-foreground text-muted-foreground">Care plans</a>
          <a href="#check" class="underline underline-offset-4 hover:text-foreground text-muted-foreground">Check your current site</a>
          <a href="#compare" class="underline underline-offset-4 hover:text-foreground text-muted-foreground">Compared with other platforms</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- Quiz -->
  <section id="fit" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold md:text-3xl">Which approach fits you?</h2>
        <p class="mt-2 text-muted-foreground">
          Five questions. The suggestion may well be a platform other than mine; that's the point.
        </p>
      </div>
      <form id="fit-form" class="mt-8 grid gap-6 lg:grid-cols-[1fr_22rem]" onsubmit="return false">
        <div class="space-y-6">
          {questions.map((question, qi) => (
            <fieldset class="rounded-lg border bg-card p-5">
              <legend class="px-1 font-semibold">{qi + 1}. {question.q}</legend>
              <div class="mt-3 grid gap-2">
                {question.answers.map((a, ai) => (
                  <label class="flex items-start gap-3 rounded-md border px-3 py-2 text-sm cursor-pointer hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input
                      type="radio"
                      name={question.id}
                      value={ai}
                      class="mt-1 accent-primary"
                      data-pts={JSON.stringify(a.pts)}
                      data-tier={a.tier ?? ''}
                    />
                    <span>{a.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
        <aside class="lg:sticky lg:top-24 self-start rounded-lg border bg-card p-6" aria-live="polite">
          <h3 class="text-sm font-medium uppercase tracking-wide text-muted-foreground">Suggested approach</h3>
          <div id="fit-empty" class="mt-3 text-sm text-muted-foreground">
            Answer the questions to see a suggestion. <span id="fit-count">0</span> of {questions.length} answered.
          </div>
          <div id="fit-result" class="mt-3 hidden">
            <p id="fit-title" class="text-xl font-semibold"></p>
            <p id="fit-why" class="mt-2 text-sm text-muted-foreground leading-relaxed"></p>
            <p id="fit-tier" class="mt-2 text-sm hidden"></p>
            <p id="fit-next" class="mt-3 text-sm"></p>
            <p class="mt-4 text-sm text-muted-foreground">Also worth a look: <span id="fit-runner" class="font-medium text-foreground"></span></p>
            <a id="fit-cta" href="/contact" class="mt-5 inline-flex items-center justify-center rounded-md text-sm font-medium h-10 px-5 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">Talk it over</a>
            <p class="mt-4 text-xs text-muted-foreground">A starting point, not a verdict. Your answers stay in your browser.</p>
          </div>
        </aside>
      </form>
    </div>
  </section>

  <!-- Included -->
  <section id="included" class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <h2 class="text-2xl font-bold md:text-3xl">Always included</h2>
      <p class="mt-2 text-muted-foreground max-w-2xl">On every site, large or small.</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {included.map((group) => (
          <div id={group.slug} class="rounded-lg border bg-card p-6">
            <h3 class="font-semibold text-lg mb-4">{group.title}</h3>
            <ul class="space-y-3 text-sm text-muted-foreground leading-relaxed">
              {group.items.map(([name, desc]) => (
                <li><span class="font-medium text-foreground">{name}.</span> {desc}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-muted-foreground max-w-2xl">
        Also included: a three-month satisfaction guarantee from launch.
      </p>
    </div>
  </section>

  <!-- Options -->
  <section id="options" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <h2 class="text-2xl font-bold md:text-3xl">Options</h2>
      <p class="mt-2 text-muted-foreground max-w-2xl">
        Add what fits, now or later. Each is quoted separately, so you can start small.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {options.map((group) => (
          <div class="rounded-lg border bg-card p-6">
            <h3 class="font-semibold text-lg mb-4">{group.title}</h3>
            <ul class="space-y-3 text-sm text-muted-foreground leading-relaxed">
              {group.items.map(([name, desc]) => (
                <li>
                  <span class="font-medium text-foreground">{name}{desc ? '.' : ''}</span>
                  {desc && ` ${desc}`}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Care plans -->
  <section id="care" class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold md:text-3xl">Care plans</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          A site with nothing to patch needs little looking after, so a plan is optional. What a plan
          adds is regular check-ups, a report, and some change time. Pick how often.
        </p>
      </div>
      <div class="mt-8 overflow-x-auto rounded-lg border">
        <table class="w-full min-w-[40rem] text-sm">
          <caption class="sr-only">What each care plan includes</caption>
          <thead class="bg-muted/40">
            <tr>
              <th scope="col" class="p-3 text-left font-semibold"><span class="sr-only">Included</span></th>
              {careCols.map((col, i) => (
                <th scope="col" class={`p-3 text-left font-semibold ${i === careCols.length - 1 ? 'text-primary' : ''}`}>{col}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {careRows.map((row) => (
              <tr class="border-t align-top">
                <th scope="row" class="p-3 text-left font-medium">{row.label}</th>
                {row.cells.map((cell) => (
                  <td class={`p-3 ${cell === '—' ? 'text-muted-foreground' : ''}`}>{cell === '—' ? <span aria-label="not included">—</span> : cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 rounded-lg border bg-card p-6">
        <h3 class="font-semibold text-lg mb-4">What a health check covers</h3>
        <ul class="grid gap-3 sm:grid-cols-2 text-sm text-muted-foreground leading-relaxed">
          {healthCheck.map(([name, desc]) => (
            <li><span class="font-medium text-foreground">{name}.</span> {desc}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Check your site -->
  <section id="check" class="py-16 border-t bg-muted/20">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold md:text-3xl">Check your current site</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          To look for yourself, these free tools run the same core tests as the health check. Paste
          in your address.
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {checkTools.map((t) => (
          <a href={t.url} rel="noopener" target="_blank" class="rounded-lg border bg-card p-5 hover:shadow-md transition-shadow">
            <span class="font-semibold">{t.name} ↗</span>
            <span class="block text-xs text-muted-foreground">{t.by}</span>
            <span class="mt-2 block text-sm text-muted-foreground">Checks {t.what}.</span>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm text-muted-foreground max-w-2xl">
        Every proposal I write starts with a full health check of your current site, free: the
        scores, what's already good, and what needs fixing, in plain English. After launch the same
        checks show the before and after. <a href="/contact" class="underline underline-offset-4 text-foreground">Ask for a proposal</a>.
      </p>
    </div>
  </section>

  <!-- Comparison -->
  <section id="compare" class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold md:text-3xl">Compared with other platforms</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          These are good products, each best at something. The main difference is the arrangement:
          with a builder you rent the site month by month; here you pay once to have it built, then
          own it and run it nearly free.
        </p>
      </div>
      <div class="mt-8 overflow-x-auto rounded-lg border">
        <table class="w-full min-w-[64rem] text-sm">
          <caption class="sr-only">Comparison of website platforms</caption>
          <thead class="bg-muted/40">
            <tr>
              <th scope="col" class="sticky left-0 z-10 bg-muted p-3 text-left font-semibold w-40">Platform</th>
              {compareCols.map((col) => (
                <th scope="col" class="p-3 text-left font-semibold">{col}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {platforms.map((p) => (
              <tr class={`border-t align-top ${p.ours ? 'bg-primary/5' : ''}`}>
                <th scope="row" class={`sticky left-0 z-10 p-3 text-left font-medium ${p.ours ? 'bg-card text-primary' : 'bg-background'}`}>{p.name}</th>
                {p.cells.map((cell) => (
                  <td class={`p-3 leading-relaxed ${p.ours ? 'text-foreground' : 'text-muted-foreground'}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-muted-foreground max-w-3xl">
        Prices are typical published US prices with annual billing, as of November 2026. Plans, prices
        and features change often, so check each company's own pricing page. Introductory prices usually
        rise at renewal. Self-hosted WordPress costs vary most, with hosting and premium plugins.
      </p>

      <div class="mt-10 max-w-2xl">
        <h3 class="text-xl font-semibold">When another platform is the better fit</h3>
        <p class="mt-3 text-muted-foreground leading-relaxed">I'll say so if one of these is you:</p>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground leading-relaxed list-disc pl-5">
          <li>You want to rearrange layouts and design pages yourself, often: Squarespace or Wix.</li>
          <li>You need a full online store with stock, shipping and tax: Shopify, or Square Online if you already use Square.</li>
          <li>You publish a lot and have someone to keep it updated: WordPress.</li>
          <li>You'd rather have no setup cost and accept the monthly fee.</li>
        </ul>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          If you have a site on one of these and want to move, I can carry the content across and keep
          its old addresses working.
        </p>
      </div>
    </div>
  </section>

  <CTA
    title="Want to talk about your site?"
    description="Tell me what you have now and what you'd like it to do. I'll reply with a plain written quote."
    cta={{ href: '/contact', label: 'Get in Touch' }}
  />
</BaseLayout>

<script define:vars={{ results, tierNames, total: questions.length }}>
  const form = document.getElementById('fit-form');
  const $ = (id) => document.getElementById(id);
  function update() {
    const checked = [...form.querySelectorAll('input[type=radio]:checked')];
    $('fit-count').textContent = String(checked.length);
    if (checked.length < total) {
      $('fit-empty').classList.remove('hidden');
      $('fit-result').classList.add('hidden');
      return;
    }
    const score = {};
    const tiers = [];
    for (const input of checked) {
      const pts = JSON.parse(input.dataset.pts || '{}');
      for (const [k, v] of Object.entries(pts)) score[k] = (score[k] || 0) + v;
      if (input.dataset.tier) tiers.push(input.dataset.tier);
    }
    const ranked = Object.keys(results).sort((a, b) => (score[b] || 0) - (score[a] || 0));
    const top = results[ranked[0]];
    $('fit-title').textContent = top.title;
    $('fit-why').textContent = top.why;
    $('fit-next').textContent = top.next;
    $('fit-runner').textContent = results[ranked[1]].title;
    const tierEl = $('fit-tier');
    if (ranked[0] === 'owned' && tiers.length) {
      // The highest tier any answer implies (C > B > A).
      const tier = tiers.sort().at(-1);
      tierEl.textContent = tierNames[tier];
      tierEl.classList.remove('hidden');
    } else {
      tierEl.classList.add('hidden');
    }
    $('fit-empty').classList.add('hidden');
    $('fit-result').classList.remove('hidden');
  }
  form.addEventListener('change', update);
  update();
</script>

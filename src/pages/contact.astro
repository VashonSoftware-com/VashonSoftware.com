---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
---

<BaseLayout
  title="Contact Us — Vashon Software"
  description="Get in touch with Vashon Software. We're ready to help with your software development, web development, mobile apps, cloud, and technology needs."
>
  <section class="py-20 md:py-28">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <!-- Left: Contact info -->
        <div>
          <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Get in Touch</h1>
          <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
            You're reaching John directly — not a support queue. I typically respond within one
            business day. For faster response, call or text:
            <a href="tel:+12069143050" class="text-primary hover:underline font-medium">206.914.3050</a>.
          </p>

          <div class="mt-10 space-y-6">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="mt-1 shrink-0 rounded-md border p-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div>
                <p class="font-semibold">Email</p>
                <ObfuscatedEmail
                  user="inquiry"
                  domain="VashonSoftware.com"
                  class="text-muted-foreground hover:text-primary transition-colors"
                />
              </div>
            </div>

            <!-- Location hint -->
            <div class="flex items-start gap-4">
              <div class="mt-1 shrink-0 rounded-md border p-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <p class="font-semibold">Location</p>
                <p class="text-muted-foreground">Vashon Island, Washington</p>
              </div>
            </div>
          </div>

          <!-- What to expect -->
          <div class="mt-12 rounded-lg border bg-muted/40 p-6">
            <h2 class="font-semibold mb-3">What to expect</h2>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                Response within one business day
              </li>
              <li class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                Free initial consultation
              </li>
              <li class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                No-obligation project scoping
              </li>
            </ul>
          </div>
        </div>

        <!-- Right: Contact form -->
        <div>
          <div class="rounded-lg border bg-card p-8">
            <h2 class="text-xl font-semibold mb-6">Send us a message</h2>

            <!-- Success state (hidden by default) -->
            <div id="form-success" class="hidden text-center py-10 space-y-4">
              <div
                class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-7 w-7 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
                >
              </div>
              <p class="text-lg font-semibold">Message sent!</p>
              <p class="text-sm text-muted-foreground">
                Thanks for reaching out. We'll get back to you within one business day.
              </p>
              <button id="send-another" class="text-sm text-primary hover:underline"
                >Send another message</button
              >
            </div>

            <!-- Error banner (hidden by default) -->
            <div
              id="form-error"
              class="hidden mb-5 rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive"
              role="alert"
            >
              Something went wrong. Please try again or email us directly.
            </div>

            <form id="contact-form" class="space-y-5" aria-label="Contact form" novalidate>
              <!-- Web3Forms access key — replace with your key from https://web3forms.com -->
              <input type="hidden" name="access_key" value="8569c13b-5145-4b64-98a4-601bc94c695a" />
              <input type="hidden" name="subject" value="New contact from VashonSoftware.com" />
              <input type="hidden" name="from_name" value="VashonSoftware.com Contact Form" />
              <!-- Honeypot spam protection -->
              <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" />

              <div class="grid gap-5 sm:grid-cols-2">
                <div class="space-y-2">
                  <label for="name" class="text-sm font-medium leading-none">
                    Name <span class="text-destructive" aria-label="required">*</span>
                  </label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    autocomplete="name"
                    placeholder="Jane Smith"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50"
                  />
                </div>
                <div class="space-y-2">
                  <label for="email" class="text-sm font-medium leading-none">
                    Email <span class="text-destructive" aria-label="required">*</span>
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder="jane@example.com"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50"
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label for="topic" class="text-sm font-medium leading-none">Subject</label>
                <input
                  id="topic"
                  name="topic"
                  type="text"
                  placeholder="What can we help you with?"
                  class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                />
              </div>

              <div class="space-y-2">
                <label for="message" class="text-sm font-medium leading-none">
                  Message <span class="text-destructive" aria-label="required">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows={5}
                  placeholder="Tell us about your project..."
                  class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 resize-none"
                ></textarea>
              </div>

              <button
                id="submit-btn"
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span id="submit-label">Send Message</span>
                <svg
                  id="submit-spinner"
                  class="hidden h-4 w-4 animate-spin"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                </svg>
              </button>

              <p class="text-xs text-muted-foreground text-center">
                Or email us directly at{' '}
                <ObfuscatedEmail
                  user="inquiry"
                  domain="VashonSoftware.com"
                  class="text-primary hover:underline"
                />
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const submitSpinner = document.getElementById('submit-spinner');
  const sendAnother = document.getElementById('send-another');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    // Show loading state
    submitBtn.disabled = true;
    submitLabel?.classList.add('hidden');
    submitSpinner?.classList.remove('hidden');
    errorEl?.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } else {
        throw new Error(json.message || 'Submission failed');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitLabel?.classList.remove('hidden');
      submitSpinner?.classList.add('hidden');
    }
  });

  sendAnother?.addEventListener('click', () => {
    form?.reset();
    form?.classList.remove('hidden');
    successEl?.classList.add('hidden');
  });
</script>

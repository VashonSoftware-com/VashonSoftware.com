---
// Example page showcasing all creative animation components
import BaseLayout from '@/layouts/BaseLayout.astro';
import EffectsGallery from '@/components/ui/EffectsGallery.svelte';
---

<BaseLayout
  title="Creative Components Gallery"
  description="Interactive showcase of canvas, SVG, and site-inspired Svelte components"
>
  <section class="components-gallery">
    <h1>Creative Components Gallery</h1>
    <p class="intro">
      Reusable Svelte components adapted from creative animations and live site effects. All
      components are standalone and can be integrated into any Astro or Svelte project.
    </p>

    <EffectsGallery client:load />

    <section class="usage-guide">
      <h2>Quick Start</h2>
      <p>All components are located in <code>src/components/ui/</code></p>

      <h3>Basic Usage in Astro</h3>
      <pre><code>---
import LineFlower from '@/components/ui/LineFlower.svelte';
---

&lt;LineFlower client:load /&gt;</code></pre>

      <h3>Using in Svelte</h3>
      <pre><code>&lt;script&gt;
  import CloudGenerator from './components/ui/CloudGenerator.svelte';
  import DigitalRain from './components/ui/DigitalRain.svelte';
&lt;/script&gt;

&lt;CloudGenerator /&gt;
&lt;DigitalRain density=&#123;1.1&#125; trailLength=&#123;14&#125; /&gt;</code></pre>

      <h3>Background Effect Example</h3>
      <pre><code>---
import DigitalRain from '@/components/ui/DigitalRain.svelte';
---

&lt;div class="relative min-h-screen overflow-hidden bg-black"&gt;
  &lt;DigitalRain client:load /&gt;
  &lt;div class="relative z-10"&gt;
    &lt;!-- Your content here --&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>

      <h3>Custom Props</h3>
      <pre><code>&lt;script&gt;
  import ElasticPebbles from '@/components/ui/ElasticPebbles.svelte';
  
  const customColors = ['#FF1493', '#00FF00', '#87CEEB'];
&lt;/script&gt;

&lt;ElasticPebbles &#123;customColors&#125; /&gt;</code></pre>
    </section>

    <section class="features-list">
      <h2>Key Features</h2>
      <ul>
        <li>✨ <strong>Production Ready</strong> - Fully tested and optimized</li>
        <li>📱 <strong>Responsive</strong> - Works on all screen sizes</li>
        <li>
          ⚡ <strong>Performance</strong> - Uses requestAnimationFrame and WebGL where appropriate
        </li>
        <li>🎨 <strong>Customizable</strong> - Configurable colors, speeds, and behaviors</li>
        <li>🔧 <strong>Lightweight</strong> - Minimal dependencies (three.js, gsap optional)</li>
        <li>
          🌌 <strong>Site Inspired</strong> - Includes live-page effects like the Meshtastic digital rain
          background
        </li>
        <li>📚 <strong>Well Documented</strong> - See CODEPEN_COMPONENTS.md for details</li>
        <li>♿ <strong>Accessible</strong> - Semantic HTML, ARIA labels where applicable</li>
        <li>🌙 <strong>Dark Mode Ready</strong> - Uses CSS variables for theming</li>
      </ul>
    </section>

    <section class="dependencies">
      <h2>Dependencies</h2>
      <p>Required packages (install as needed):</p>
      <pre><code>pnpm add three       # For WebGLFlowers
pnpm add gsap        # For ParticleAnimation
none                # For DigitalRain</code></pre>
    </section>
  </section>
</BaseLayout>

<style>
  .components-gallery {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px;
  }

  h1 {
    font-size: 48px;
    margin-bottom: 20px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-foreground) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .intro {
    font-size: 18px;
    color: var(--muted-foreground);
    margin-bottom: 60px;
    line-height: 1.6;
  }

  .usage-guide {
    background: var(--muted);
    padding: 40px;
    border-radius: 12px;
    margin-bottom: 40px;
  }

  .usage-guide h2 {
    margin-top: 0;
  }

  .usage-guide h3 {
    margin-top: 24px;
    margin-bottom: 12px;
  }

  pre {
    background: var(--background);
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid var(--muted);
  }

  code {
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 13px;
    color: var(--foreground);
  }

  .features-list {
    background: var(--card);
    padding: 40px;
    border-radius: 12px;
    margin-bottom: 40px;
    border: 1px solid var(--primary);
  }

  .features-list ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }

  .features-list li {
    padding: 12px;
    background: var(--muted);
    border-radius: 8px;
    font-size: 14px;
  }

  .dependencies {
    padding: 24px;
    background: var(--muted);
    border-radius: 12px;
    border-left: 4px solid var(--primary);
  }

  .dependencies pre {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .components-gallery {
      padding: 40px 16px;
    }

    h1 {
      font-size: 32px;
    }

    .usage-guide,
    .features-list,
    .dependencies {
      padding: 24px;
    }
  }
</style>

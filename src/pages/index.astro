---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Features from '@/components/sections/Features.astro';
import CTA from '@/components/sections/CTA.astro';

const services = [
  {
    title: 'Custom Applications',
    description:
      'Bespoke software engineered around your business processes — from internal tools to customer-facing platforms.',
    icon: 'zap',
  },
  {
    title: 'Web Development',
    description:
      'High-performance, accessible websites and web applications built with modern frameworks and best practices.',
    icon: 'globe',
  },
  {
    title: 'Mobile Apps',
    description:
      'Native and cross-platform mobile applications for iOS and Android, crafted for seamless user experiences.',
    icon: 'users',
  },
  {
    title: 'Cloud Solutions',
    description:
      'Scalable cloud architecture, infrastructure design, and migration services to modernize your technology stack.',
    icon: 'chart',
  },
  {
    title: 'E-commerce & CMS',
    description:
      'Online storefronts and content management systems that are easy to manage and built to convert.',
    icon: 'lock',
  },
  {
    title: 'Disaster Technology',
    description:
      'Resilient, mission-critical systems designed to keep you operational when it matters most.',
    icon: 'shield',
  },
];
---

<BaseLayout
  title="Vashon Software — Crafted Software Solutions"
  description="Vashon Software specializes in custom application development, web development, mobile apps, cloud solutions, and disaster technology. Contact us to get started."
>
  <Hero
    title="Software crafted to fit your needs."
    subtitle="Vashon Software builds <mark>custom applications</mark>, websites, mobile apps, and <mark>cloud solutions</mark> for businesses that need technology that works — reliably and beautifully."
    primaryCta={{ href: '/contact', label: 'Get in Touch' }}
    secondaryCta={{ href: '/services', label: 'Our Services' }}
  />

  <Features
    title="What we build"
    subtitle="From bespoke software to resilient infrastructure, we deliver solutions across the full technology stack."
    features={services}
  />

  <CTA
    title="Ready to start your project?"
    description="Tell us what you need. We'll work with you to scope, design, and deliver software that solves real problems."
    cta={{ href: '/contact', label: 'Contact Us' }}
  />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Features from '@/components/sections/Features.astro';
import CTA from '@/components/sections/CTA.astro';

const services = [
  {
    title: 'Websites',
    description:
      'Modern low-JS, static mobile-first sites with proven 100 PageSpeed scores for Performance, Accessibility, Best Practices & SEO. Creative design, user editable — all at an economical price.',
    icon: 'globe',
  },
  {
    title: 'Crafted Software',
    description:
      'Microservices-based custom applications using C#, TypeScript, Python, C++ and more. AI with Small Language Models for GIS & IoT, Secure IoT Development, and Data Analytics on modern cloud solutions.',
    icon: 'zap',
  },
  {
    title: 'Disaster Technology',
    description:
      'ICS, NIMS & NRF-based solutions for Emergency Operations Centers. Resilient systems that operate independently of the cloud — but leverage it when available.',
    icon: 'shield',
  },
];
---

<BaseLayout
  title="Vashon Software"
  description="Founded in 2002, Vashon Software delivers websites, crafted software, and disaster technology — cutting-edge, agile, modular solutions built for today and designed to grow for tomorrow."
>
  <Hero
    title="Innovative solutions for your goals and mission."
    subtitle="Founded in 2002, Vashon Software uses <mark>cutting-edge technologies</mark> enabling agile projects that are creative, modular, and simple — built to fit today's objectives and <mark>grow for tomorrow's</mark>."
    primaryCta={{ href: '/contact', label: 'Get in Touch' }}
    secondaryCta={{ href: '/services', label: 'Our Services' }}
  />

  <Features
    title="What we build"
    subtitle="Websites, crafted software, and disaster technology — delivered with expertise across the full technology stack."
    features={services}
  />

  <CTA
    title="Ready to start your project?"
    description="Tell us what you need. We'll work with you to scope, design, and deliver solutions that solve real problems — reliably and creatively."
    cta={{ href: '/contact', label: 'Contact Us' }}
  />
</BaseLayout>

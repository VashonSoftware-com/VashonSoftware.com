---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Features from '@/components/sections/Features.astro';
import CTA from '@/components/sections/CTA.astro';
import { serviceAreas } from '@/data/services';

const services = serviceAreas.map((s) => ({
  title: s.title,
  description: s.tile,
  icon: s.icon,
  href: s.href,
}));

const localProjects = [
  { title: 'Website refresh or fix', desc: "Update an existing site, fix what's broken" },
  { title: 'New small site', desc: 'One-page to five-page business or portfolio site' },
  {
    title: 'Domains & email',
    desc: 'Your own domain, registered to you, and email that reaches inboxes',
    href: '/domains',
  },
  {
    title: 'Tech consult',
    desc: 'An hour or two to get your project pointed in the right direction',
  },
  { title: 'Custom script or tool', desc: "Automate something that's wasting your time" },
  { title: 'Emergency / off-hours help', desc: 'When something breaks and you need it fixed fast' },
];
---

<BaseLayout
  title="Vashon Software"
  description="John Cornelison · Vashon Software · Software architect and developer on Vashon Island, WA. Websites, custom software, and emergency tech. Local projects welcome. Founded 2010."
>
  <Hero
    title="I'm John Cornelison — software architect, Vashon islander, one-person studio."
    subtitle="30+ years building websites, custom software, and emergency technology. <mark>Founded in 2010</mark>, Vashon Software takes on projects of any size — from a quick site fix to a complex system architecture."
    primaryCta={{ href: '/about#contact', label: 'Get in Touch' }}
    secondaryCta={{ href: '#what-i-build', label: 'What I Build' }}
  />

  <Features
    id="what-i-build"
    title="What I build"
    subtitle="Websites, crafted software, emergency management tech, and architecture consulting — across the full technology stack."
    features={services}
  />

  <!-- Local Projects -->
  <section class="py-16 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl">
        <h2 class="section-title">Local &amp; One-Off Projects Welcome</h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          Not every project needs a big agency. I work with Vashon businesses, nonprofits, and
          neighbors on:
        </p>
        <ul class="mt-4 space-y-3 text-muted-foreground">
          {
            localProjects.map((item) => (
              <li class="flex items-start gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="mt-1.5 h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="font-medium text-foreground underline underline-offset-4 hover:text-primary"
                    >
                      {item.title}
                    </a>
                  ) : (
                    <span class="font-medium text-foreground">{item.title}</span>
                  )}{' '}
                  — {item.desc}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm font-medium">Island rates. Quick turnaround. No overhead.</p>
        <a
          href="/about#contact"
          class="mt-6 inline-flex items-center justify-center rounded-md text-sm font-medium h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Let's Talk
        </a>
      </div>
    </div>
  </section>

  <CTA
    title="Ready to start your project?"
    description="Tell me what you need — I'll help you scope, design, and ship something that actually solves the problem, without the corporate runaround."
    cta={{ href: '/about#contact', label: 'Contact Me' }}
  />

  <!-- Credentials trust line -->
  <section class="py-6 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <p class="text-center text-sm text-muted-foreground">
        30+ years in software · Microsoft · IBM · MEDCOM · Founded 2010 · Vashon Island
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactForm from '@/components/ContactForm.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
---

<BaseLayout
  title="About John Cornelison"
  description="About John Cornelison, and how to reach him: 30+ years in software, IBM, U.S. Army healthcare IT, FEMA graduate, and founding president of VashonBePrepared. Based on Vashon Island, WA."
>
  <PageHeader title="About John Cornelison">
    Software architect, emergency tech builder, and Vashon islander since 2005.
  </PageHeader>

  <!-- Bio -->
  <section class="py-12 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="max-w-2xl space-y-5 text-muted-foreground leading-relaxed">
        <p>
          I've been writing software professionally since 1992 — from porting Windows NT to PowerPC
          at IBM's Kirkland Programming Center, to building healthcare information exchanges for the
          U.S. Army at Madigan, to preparing designs for Thailand's Phuket Provincial Intelligent
          Operations Center.
        </p>
        <p>
          Since 2010, I've run Vashon Software from the island — taking on everything from modern
          static websites for local businesses to complex microservices architectures for emergency
          operations centers.
        </p>
        <p>
          I'm a full-stack developer, system architect, and longtime Vashon community member. If you
          need something built — big or small — let's talk.
        </p>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="py-12 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <h2 class="section-title mb-8">Background & Credentials</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            { label: 'Founded Vashon Software', value: '2010' },
            { label: 'IBM Kirkland', value: 'NT/PowerPC team, 1993–1995' },
            { label: 'Madigan Army / WRMC', value: 'Healthcare IT Architect, 2006–2010' },
            { label: 'FEMA EMI Graduate', value: '35+ courses, 2009–present' },
            { label: 'FCC Licensed', value: 'KE7KDQ General Class' },
            { label: 'VashonBePrepared', value: 'Founding President & CTO, 2005–2024' },
            { label: 'Seeed Studio Ranger', value: 'IoT consultant & community advocate' },
            { label: 'BA Mathematics', value: 'The Colorado College, 1981' },
          ].map((item) => (
            <div class="rounded-lg border bg-card p-5">
              <p class="font-semibold text-sm">{item.label}</p>
              <p class="mt-1 text-sm text-muted-foreground">{item.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Open Source Projects -->
  <section class="py-12 border-t">
    <div class="container max-w-5xl mx-auto px-4">
      <h2 class="section-title mb-2">Projects I've Built</h2>
      <p class="text-muted-foreground mb-8">
        Just a few of the open-source tools I've developed and maintain:
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            {
              name: 'EOC.online',
              href: 'https://eoc.online/',
              description:
                'Software for Emergency Operations Centers — designed to run cloud or on-prem, with or without internet.',
            },
            {
              name: 'Mesh101',
              href: 'https://mesh101.com',
              description:
                'LoRa radio mesh network using LoRaWAN, MeshCore & Meshtastic for off-grid communications.',
            },
            {
              name: 'RangerTrak',
              href: 'https://www.RangerTrak.org',
              description:
                'Angular PWA for Search & Rescue member tracking — works without cell or internet coverage.',
            },
            {
              name: 'OpenFemaNgClient',
              href: 'https://github.com/eoconline/OpenFemaNgClient',
              description:
                'Angular + Google Maps tool for analyzing and visualizing OpenFEMA disaster data APIs.',
            },
          ].map((project) => (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border bg-card p-6 hover:shadow-md transition-shadow group"
            >
              <h3 class="font-semibold text-lg mb-2 group-hover:text-primary transition-colors">
                {project.name} →
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{project.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact (was /contact; /contact redirects here) -->
  <section id="contact" class="py-16 border-t bg-muted/20 scroll-mt-24">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="section-title">Get in touch</h2>
          <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
            You reach me directly, not a support queue. I typically respond within one business day.
            For faster response, call or text:
            <a href="tel:+12069143050" class="text-primary hover:underline font-medium"
              >206.914.3050</a
            >.
          </p>

          <div class="mt-10 space-y-6">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="mt-1 shrink-0 rounded-md border p-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div>
                <p class="font-semibold">Email</p>
                <ObfuscatedEmail
                  user="inquiry"
                  domain="VashonSoftware.com"
                  class="text-muted-foreground hover:text-primary transition-colors"
                />
              </div>
            </div>

            <!-- Location hint -->
            <div class="flex items-start gap-4">
              <div class="mt-1 shrink-0 rounded-md border p-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <p class="font-semibold">Location</p>
                <p class="text-muted-foreground">Vashon Island, Washington</p>
              </div>
            </div>
          </div>

          <!-- What to expect -->
          <div class="mt-12 rounded-lg border bg-muted/40 p-6">
            <h3 class="text-base font-semibold mb-3">What to expect</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              <li class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                Response within one business day
              </li>
              <li class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                Free initial consultation
              </li>
              <li class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                No-obligation project scoping
              </li>
            </ul>
          </div>
        </div>

        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
